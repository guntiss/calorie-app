# Copy to .env and fill in.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=calorie
POSTGRES_PASSWORD=calorie
POSTGRES_DB=calorie
# Used by the app. Host is `db` inside compose, localhost outside.
DATABASE_URL=postgres://calorie:calorie@localhost:5432/calorie
# Migrations need a direct session, not a pooled one. Neon's integration sets
# DATABASE_URL_UNPOOLED for you; set MIGRATION_DATABASE_URL to override both.
# Locally, leaving these unset falls back to DATABASE_URL above.
# DATABASE_URL_UNPOOLED=

# --- Sessions ---------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<your-domain>/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Nutrition suggestions (optional) ---------------------------------------
# https://aistudio.google.com/apikey
# Without a key the "Edit food" dialog simply offers no suggested macros.
NUXT_GEMINI_API_KEY=
# NUXT_GEMINI_MODEL=gemini-3.6-flash

# --- Deployment -------------------------------------------------------------
SITE_DOMAIN=calorie.example.com
SITE_URL=https://calorie.example.com
